<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>CatanRoguelike.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="CatanRoguelike.Core" />
    <Using Include="CatanRoguelike.Core.Hex" Alias="Hex" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\_Project\Scripts\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Tests\EditMode\**\*.cs" Link="EditMode\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\sim-runner\SimDriver.cs" Link="SimRunner\SimDriver.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
