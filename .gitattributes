* text=auto

*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.shader text eol=lf

# Unity YAML — text for diffs, no automatic merge
*.unity text merge=binary
*.prefab text merge=binary
*.asset text merge=binary
*.mat text merge=binary
*.controller text merge=binary
*.anim text merge=binary
*.overrideController text merge=binary
*.physicMaterial text merge=binary
*.physicsMaterial2D text merge=binary
*.mask text merge=binary
*.flare text merge=binary
*.guiskin text merge=binary

# Git LFS for binaries (track BEFORE any art pass)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
